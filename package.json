{
  "name": "uniplan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/ensure-demo-db.mjs",
    "setup:cloud": "node scripts/ensure-demo-db.mjs",
    "verify:cloud": "npm run typecheck && npm run build",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:use:sqlite": "cp prisma/schema.sqlite.prisma prisma/schema.prisma && printf 'DATABASE_URL=\"file:./dev.db\"\\n' > .env",
    "db:use:postgres": "cp prisma/schema.postgres.prisma prisma/schema.prisma && cp .env.postgres.example .env"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-table": "^8.21.3",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
