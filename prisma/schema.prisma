generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  RAW_MATERIAL
  COMPONENT
  FINISHED_GOOD
  CONSUMABLE
  SERVICE
}

enum BomVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum InventoryTransactionType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  PRODUCTION
  REVERSAL
}

enum AuditOutcome {
  SUCCEEDED @map("succeeded")
  DENIED    @map("denied")
  FAILED    @map("failed")

  @@map("audit_outcome")
}

model Company {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  domains               Domain[]
  roles                 Role[]
  menuItems             MenuItem[]
  customers             Customer[]
  employees             Employee[]
  itemCategories        ItemCategory[]
  items                 Item[]
  boms                  Bom[]
  warehouses            Warehouse[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  inventoryEntries      InventoryEntry[]
  salesOrders           SalesOrder[]
  invoices              Invoice[]
  consultations         Consultation[]
  serviceCases          ServiceCase[]
  auditEvents           AuditEvent[]

  @@map("companies")
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  domainId     String?
  email        String
  passwordHash String
  name         String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company               Company                @relation(fields: [companyId], references: [id])
  domain                Domain?                @relation(fields: [companyId, domainId], references: [companyId, id], onDelete: NoAction)
  userRoles             UserRole[]
  authSessions          AuthSession[]
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionCreator")
  auditEvents           AuditEvent[]           @relation("AuditEventActor")

  @@unique([companyId, email])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@map("users")
}

model AuditEvent {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String
  actorUserId        String?
  action             String       @db.VarChar(80)
  resourceType       String       @db.VarChar(64)
  resourceId         String?      @db.VarChar(128)
  outcome            AuditOutcome
  correlationHash    String?      @db.Char(64)
  idempotencyKeyHash String?      @db.Char(64)
  subjectHash        String?      @db.Char(64)
  metadata           Json         @default("{}")
  createdAt          DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor   User?   @relation("AuditEventActor", fields: [companyId, actorUserId], references: [companyId, id], onDelete: NoAction)

  @@unique([companyId, action, idempotencyKeyHash])
  @@index([companyId, createdAt, id])
  @@index([companyId, action, createdAt])
  @@index([companyId, resourceType, resourceId, createdAt])
  @@index([companyId, outcome, createdAt])
  @@map("audit_events")
}

model AuthSession {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model LoginRateLimitBucket {
  bucketKey       String   @id @db.Char(64)
  attemptCount    Int
  windowStartedAt DateTime
  windowExpiresAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowExpiresAt])
  @@map("login_rate_limit_buckets")
}

model Domain {
  id         String   @id @default(cuid())
  companyId  String
  code       String
  name       String
  domainName String
  domainType String   @default("ERP")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  users     User[]
  roles     Role[]
  menuItems MenuItem[]

  @@unique([companyId, code])
  @@unique([companyId, domainName])
  @@unique([companyId, id])
  @@map("domains")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  domainId    String?
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  domain      Domain?          @relation(fields: [companyId, domainId], references: [companyId, id], onDelete: NoAction)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)
  role Role @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@unique([companyId, id])
  @@map("user_roles")
}

model MenuItem {
  id           String   @id @default(cuid())
  companyId    String
  domainId     String?
  parentId     String?
  code         String
  label        String
  href         String?
  resourceCode String
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  domain      Domain?          @relation(fields: [companyId, domainId], references: [companyId, id], onDelete: NoAction)
  parent      MenuItem?        @relation("MenuTree", fields: [companyId, parentId], references: [companyId, id], onDelete: NoAction)
  children    MenuItem[]       @relation("MenuTree")
  permissions RolePermission[]

  @@unique([companyId, code])
  @@unique([companyId, resourceCode])
  @@unique([companyId, id])
  @@index([companyId, parentId, active, sortOrder])
  @@map("menu_items")
}

model RolePermission {
  id         String   @id @default(cuid())
  companyId  String
  roleId     String
  menuItemId String
  canRead    Boolean  @default(false)
  canCreate  Boolean  @default(false)
  canUpdate  Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canAdmin   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role     Role     @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [companyId, menuItemId], references: [companyId, id], onDelete: Cascade)

  @@unique([roleId, menuItemId])
  @@unique([companyId, id])
  @@map("role_permissions")
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  grade     String?
  status    String   @default("active")
  phone     String?
  email     String?
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  invoices      Invoice[]
  salesOrders   SalesOrder[]
  consultations Consultation[]
  serviceCases  ServiceCase[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, name])
  @@map("customers")
}

model Employee {
  id         String   @id @default(cuid())
  companyId  String
  employeeNo String
  name       String
  department String?
  position   String?
  active     Boolean  @default(true)
  isSales    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  salesOrders SalesOrder[]

  @@unique([companyId, employeeNo])
  @@unique([companyId, id])
  @@map("employees")
}

model ItemCategory {
  id          String   @id @default(cuid())
  companyId   String
  parentId    String?
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  parent   ItemCategory?  @relation("ItemCategoryTree", fields: [companyId, parentId], references: [companyId, id], onDelete: NoAction)
  children ItemCategory[] @relation("ItemCategoryTree")
  items    Item[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, parentId, active])
  @@map("item_categories")
}

model Item {
  id             String   @id @default(cuid())
  companyId      String
  categoryId     String?
  code           String
  name           String
  itemType       ItemType
  unit           String   @default("ea")
  standardPrice  Decimal  @default(0) @db.Decimal(18, 2)
  costPrice      Decimal  @default(0) @db.Decimal(18, 2)
  trackInventory Boolean  @default(true)
  taxable        Boolean  @default(true)
  active         Boolean  @default(true)
  description    String?
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company           Company            @relation(fields: [companyId], references: [id])
  category          ItemCategory?      @relation(fields: [companyId, categoryId], references: [companyId, id], onDelete: NoAction)
  outputBom         Bom?
  bomComponents     BomComponent[]     @relation("BomComponentItem")
  inventoryBalances InventoryBalance[]
  inventoryEntries  InventoryEntry[]
  salesOrderItems   SalesOrderItem[]
  invoiceItems      InvoiceItem[]
  serviceCases      ServiceCase[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, name])
  @@index([companyId, active, itemType])
  @@map("items")
}

model Bom {
  id           String   @id @default(cuid())
  companyId    String
  outputItemId String   @unique
  code         String
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company      @relation(fields: [companyId], references: [id])
  outputItem Item         @relation(fields: [companyId, outputItemId], references: [companyId, id])
  versions   BomVersion[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@unique([companyId, outputItemId])
  @@index([companyId, active])
  @@map("boms")
}

model BomVersion {
  id          String           @id @default(cuid())
  companyId   String
  bomId       String
  revision    Int
  status      BomVersionStatus @default(DRAFT)
  notes       String?
  activatedAt DateTime?
  retiredAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  bom                   Bom                    @relation(fields: [companyId, bomId], references: [companyId, id])
  components            BomComponent[]         @relation("BomVersionComponents")
  pinnedByComponents    BomComponent[]         @relation("PinnedChildBomVersion")
  inventoryTransactions InventoryTransaction[]

  @@unique([bomId, revision])
  @@unique([companyId, id])
  @@index([bomId, status])
  @@map("bom_versions")
}

model BomComponent {
  id                String   @id @default(cuid())
  companyId         String
  bomVersionId      String
  componentItemId   String
  childBomVersionId String?
  quantity          Decimal  @db.Decimal(18, 6)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bomVersion      BomVersion  @relation("BomVersionComponents", fields: [companyId, bomVersionId], references: [companyId, id], onDelete: Cascade)
  componentItem   Item        @relation("BomComponentItem", fields: [companyId, componentItemId], references: [companyId, id])
  childBomVersion BomVersion? @relation("PinnedChildBomVersion", fields: [companyId, childBomVersionId], references: [companyId, id], onDelete: NoAction)

  @@unique([bomVersionId, componentItemId])
  @@unique([companyId, id])
  @@index([childBomVersionId])
  @@map("bom_components")
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company            @relation(fields: [companyId], references: [id])
  inventoryBalances InventoryBalance[]
  inventoryEntries  InventoryEntry[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, active])
  @@map("warehouses")
}

model InventoryBalance {
  id             String   @id @default(cuid())
  companyId      String
  itemId         String
  warehouseId    String
  quantity       Decimal  @default(0) @db.Decimal(18, 6)
  safetyQuantity Decimal  @default(0) @db.Decimal(18, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  item      Item      @relation(fields: [companyId, itemId], references: [companyId, id])
  warehouse Warehouse @relation(fields: [companyId, warehouseId], references: [companyId, id])

  @@unique([companyId, itemId, warehouseId])
  @@unique([companyId, id])
  @@index([companyId, warehouseId, itemId])
  @@map("inventory_balances")
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  companyId       String
  transactionType InventoryTransactionType
  idempotencyKey  String
  payloadHash     String                   @db.Char(64)
  occurredAt      DateTime
  reference       String?
  memo            String?
  createdById     String?
  bomVersionId    String?
  reversalOfId    String?                  @unique
  createdAt       DateTime                 @default(now())

  company    Company               @relation(fields: [companyId], references: [id])
  createdBy  User?                 @relation("InventoryTransactionCreator", fields: [companyId, createdById], references: [companyId, id], onDelete: NoAction)
  bomVersion BomVersion?           @relation(fields: [companyId, bomVersionId], references: [companyId, id], onDelete: NoAction)
  reversalOf InventoryTransaction? @relation("InventoryReversal", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: NoAction)
  reversal   InventoryTransaction? @relation("InventoryReversal")
  entries    InventoryEntry[]

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, id])
  @@unique([companyId, reversalOfId])
  @@index([companyId, occurredAt])
  @@map("inventory_transactions")
}

model InventoryEntry {
  id            String   @id @default(cuid())
  companyId     String
  transactionId String
  lineNumber    Int
  itemId        String
  warehouseId   String
  quantity      Decimal  @db.Decimal(18, 6)
  createdAt     DateTime @default(now())

  company     Company              @relation(fields: [companyId], references: [id])
  transaction InventoryTransaction @relation(fields: [companyId, transactionId], references: [companyId, id])
  item        Item                 @relation(fields: [companyId, itemId], references: [companyId, id])
  warehouse   Warehouse            @relation(fields: [companyId, warehouseId], references: [companyId, id])

  @@unique([transactionId, lineNumber])
  @@unique([companyId, id])
  @@index([companyId, warehouseId, itemId])
  @@map("inventory_entries")
}

model SalesOrder {
  id              String   @id @default(cuid())
  companyId       String
  orderNo         String
  customerId      String
  salesEmployeeId String?
  status          String   @default("confirmed")
  orderDate       DateTime
  supplyAmount    Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id])
  customer      Customer         @relation(fields: [companyId, customerId], references: [companyId, id])
  salesEmployee Employee?        @relation(fields: [companyId, salesEmployeeId], references: [companyId, id], onDelete: NoAction)
  items         SalesOrderItem[]
  invoices      Invoice[]

  @@unique([companyId, orderNo])
  @@unique([companyId, id])
  @@index([companyId, orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String  @id @default(cuid())
  companyId    String
  salesOrderId String
  itemId       String?
  itemName     String
  quantity     Decimal @db.Decimal(18, 6)
  unitPrice    Decimal @db.Decimal(18, 2)
  supplyAmount Decimal @db.Decimal(18, 2)
  taxAmount    Decimal @db.Decimal(18, 2)
  totalAmount  Decimal @db.Decimal(18, 2)

  salesOrder SalesOrder @relation(fields: [companyId, salesOrderId], references: [companyId, id], onDelete: Cascade)
  item       Item?      @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: NoAction)

  @@unique([companyId, id])
  @@map("sales_order_items")
}

model Invoice {
  id              String    @id @default(cuid())
  companyId       String
  invoiceNo       String
  customerId      String
  salesOrderId    String?
  issueDate       DateTime
  dueDate         DateTime?
  status          String    @default("issued")
  supplyAmount    Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal   @default(0) @db.Decimal(18, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal   @default(0) @db.Decimal(18, 2)
  memo            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company       @relation(fields: [companyId], references: [id])
  customer   Customer      @relation(fields: [companyId, customerId], references: [companyId, id])
  salesOrder SalesOrder?   @relation(fields: [companyId, salesOrderId], references: [companyId, id], onDelete: NoAction)
  items      InvoiceItem[]
  payments   Payment[]

  @@unique([companyId, invoiceNo])
  @@unique([companyId, id])
  @@index([companyId, issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id           String  @id @default(cuid())
  companyId    String
  invoiceId    String
  itemId       String?
  itemName     String
  quantity     Decimal @db.Decimal(18, 6)
  unitPrice    Decimal @db.Decimal(18, 2)
  supplyAmount Decimal @db.Decimal(18, 2)
  taxAmount    Decimal @db.Decimal(18, 2)
  totalAmount  Decimal @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Cascade)
  item    Item?   @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: NoAction)

  @@unique([companyId, id])
  @@map("invoice_items")
}

model Payment {
  id        String   @id @default(cuid())
  companyId String
  invoiceId String
  paidAt    DateTime
  amount    Decimal  @db.Decimal(18, 2)
  method    String
  memo      String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@map("payments")
}

model Consultation {
  id         String   @id @default(cuid())
  companyId  String
  customerId String?
  type       String
  status     String   @default("open")
  content    String
  result     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction)

  @@unique([companyId, id])
  @@index([companyId, status])
  @@map("consultations")
}

model ServiceCase {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String?
  itemId      String?
  status      String    @default("received")
  symptom     String
  result      String?
  receivedAt  DateTime
  dueAt       DateTime?
  completedAt DateTime?
  memo        String?

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction)
  item     Item?     @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: NoAction)

  @@unique([companyId, id])
  @@index([companyId, status])
  @@map("service_cases")
}
