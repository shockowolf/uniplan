generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  domains            Domain[]
  roles              Role[]
  menus              Menu[]
  menuNodes          MenuNode[]
  customers          Customer[]
  employees          Employee[]
  productCategories  ProductCategory[]
  products           Product[]
  warehouses         Warehouse[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  salesOrders        SalesOrder[]
  invoices           Invoice[]
  consultations      Consultation[]
  serviceCases       ServiceCase[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  domainId     String?
  email        String
  passwordHash String
  name         String
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  domain    Domain?    @relation(fields: [domainId], references: [id])
  userRoles UserRole[]

  @@unique([companyId, email])
}

model Domain {
  id         String   @id @default(cuid())
  companyId  String
  code       String
  name       String
  domainName String
  domainType String   @default("ERP")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  users     User[]
  roles     Role[]
  menuNodes MenuNode[]

  @@unique([companyId, code])
  @@unique([companyId, domainName])
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  domainId    String?
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id])
  domain      Domain?              @relation(fields: [domainId], references: [id])
  userRoles   UserRole[]
  permissions RoleMenuPermission[]

  @@unique([companyId, code])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Menu {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  label        String
  href         String?
  domainType   String   @default("ERP")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  legacyMenuId String?
  legacyTable  String   @default("tbcom_menu")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id])
  nodes   MenuNode[]

  @@unique([companyId, code])
  @@index([companyId, active, sortOrder])
}

model MenuNode {
  id          String   @id @default(cuid())
  companyId   String
  domainId    String?
  menuId      String?
  parentId    String?
  label       String
  href        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  legacyMapId String?
  legacyTable String   @default("tbcom_menu_map")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id])
  domain      Domain?              @relation(fields: [domainId], references: [id])
  menu        Menu?                @relation(fields: [menuId], references: [id])
  parent      MenuNode?            @relation("MenuTree", fields: [parentId], references: [id])
  children    MenuNode[]           @relation("MenuTree")
  permissions RoleMenuPermission[]

  @@index([companyId, domainId, parentId, sortOrder])
  @@index([companyId, active])
}

model RoleMenuPermission {
  id         String   @id @default(cuid())
  roleId     String
  menuNodeId String
  canRead    Boolean  @default(true)
  canCreate  Boolean  @default(false)
  canUpdate  Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canAdmin   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuNode MenuNode @relation(fields: [menuNodeId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuNodeId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  grade     String?
  status    String   @default("active")
  phone     String?
  email     String?
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  invoices      Invoice[]
  salesOrders   SalesOrder[]
  consultations Consultation[]
  serviceCases  ServiceCase[]

  @@unique([companyId, code])
  @@index([companyId, name])
}

model Employee {
  id         String   @id @default(cuid())
  companyId  String
  employeeNo String
  name       String
  department String?
  position   String?
  active     Boolean  @default(true)
  isSales    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  salesOrders SalesOrder[]

  @@unique([companyId, employeeNo])
}

model ProductCategory {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  name        String
  description String?
  active      Boolean @default(true)

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, code])
}

model Product {
  id            String   @id @default(cuid())
  companyId     String
  categoryId    String?
  code          String
  name          String
  productType   String   @default("product")
  unit          String   @default("ea")
  standardPrice Int      @default(0)
  costPrice     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id])
  category           ProductCategory?    @relation(fields: [categoryId], references: [id])
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  salesOrderItems    SalesOrderItem[]
  invoiceItems       InvoiceItem[]
  serviceCases       ServiceCase[]

  @@unique([companyId, code])
  @@index([companyId, name])
}

model Warehouse {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  location  String?
  active    Boolean @default(true)

  company            Company             @relation(fields: [companyId], references: [id])
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]

  @@unique([companyId, code])
}

model InventoryBalance {
  id             String   @id @default(cuid())
  companyId      String
  productId      String
  warehouseId    String
  quantity       Int      @default(0)
  safetyQuantity Int      @default(0)
  updatedAt      DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
}

model InventoryMovement {
  id           String   @id @default(cuid())
  companyId    String
  productId    String
  warehouseId  String
  movementType String
  quantity     Int
  movementAt   DateTime
  reason       String?
  memo         String?
  createdAt    DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([companyId, movementAt])
}

model SalesOrder {
  id              String   @id @default(cuid())
  companyId       String
  orderNo         String
  customerId      String
  salesEmployeeId String?
  status          String   @default("confirmed")
  orderDate       DateTime
  supplyAmount    Int      @default(0)
  taxAmount       Int      @default(0)
  totalAmount     Int      @default(0)
  memo            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id])
  salesEmployee Employee?        @relation(fields: [salesEmployeeId], references: [id])
  items         SalesOrderItem[]
  invoices      Invoice[]

  @@unique([companyId, orderNo])
  @@index([companyId, orderDate])
}

model SalesOrderItem {
  id           String  @id @default(cuid())
  salesOrderId String
  productId    String?
  productName  String
  quantity     Int
  unitPrice    Int
  supplyAmount Int
  taxAmount    Int
  totalAmount  Int

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])
}

model Invoice {
  id              String    @id @default(cuid())
  companyId       String
  invoiceNo       String
  customerId      String
  salesOrderId    String?
  issueDate       DateTime
  dueDate         DateTime?
  status          String    @default("issued")
  supplyAmount    Int       @default(0)
  taxAmount       Int       @default(0)
  totalAmount     Int       @default(0)
  paidAmount      Int       @default(0)
  remainingAmount Int       @default(0)
  memo            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company    Company       @relation(fields: [companyId], references: [id])
  customer   Customer      @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  items      InvoiceItem[]
  payments   Payment[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, issueDate])
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  productId    String?
  itemName     String
  quantity     Int
  unitPrice    Int
  supplyAmount Int
  taxAmount    Int
  totalAmount  Int

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  paidAt    DateTime
  amount    Int
  method    String
  memo      String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Consultation {
  id         String   @id @default(cuid())
  companyId  String
  customerId String?
  type       String
  status     String   @default("open")
  content    String
  result     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([companyId, status])
}

model ServiceCase {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String?
  productId   String?
  status      String    @default("received")
  symptom     String
  result      String?
  receivedAt  DateTime
  dueAt       DateTime?
  completedAt DateTime?
  memo        String?

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  product  Product?  @relation(fields: [productId], references: [id])

  @@index([companyId, status])
}
