# Install as /etc/uniplan/backup.env owned by root with mode 0600.
# Fill secrets locally; never commit the populated file.
NODE_ENV=production
DATABASE_URL=
UNIPLAN_BACKUP_DIRECTORY=/var/lib/uniplan-backups
UNIPLAN_BACKUP_LOCK_FILE=/run/uniplan-backup/backup.lock
UNIPLAN_BACKUP_AGE_RECIPIENT=
UNIPLAN_BACKUP_REQUIRE_OFFSITE=true
UNIPLAN_BACKUP_RCLONE_DESTINATION=remote:bucket/uniplan
UNIPLAN_BACKUP_RETENTION_COUNT=14
RCLONE_CONFIG=/etc/uniplan/rclone.conf
